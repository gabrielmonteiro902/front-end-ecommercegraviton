# URL base da API do backend (Laravel)
VITE_API_URL=http://localhost:8000/api/v1

# Supabase — use a chave ANÔNIMA pública (role "anon"), protegida por RLS no servidor.
# NUNCA coloque a service_role key aqui.
# ⚠️ Toda variável VITE_* é embutida no bundle do cliente em texto claro: trate como pública.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_publica
